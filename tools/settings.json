{
    "windows": {
        "project": {
            "script_file": "ice.bat",
            "fbuild": {
                "vstudio_solution_file": "IceShard.sln"
            }
        },
        "doxy": {
            "path": "~/bin/doxy/doxygen.exe"
        }
    },
    "linux": {
        "project": {
            "script_file": "ice.sh"
        },
        "android": {
          "sdk": {
            "root": "~/.android/sdk"
          }
        }
    },
    "project": {
        "output_dir": "build",
        "source_dir": "source/code",
        "fbuild": {
            "config_file": "source/fbuild.bff"
        }
    },
    "license": {
        "spdx": "MIT",
        "authors": "Dandielo <dandielo@iceshard.net>",
        "mode_sources": {
            "file_extensions": {
                ".bff": true, ".inl": true,
                ".hxx": true, ".cxx": true
            }
        }
    },
    "android": {
        "gradle": {
            "version": "9.6.0"
        },
        "projects": [ "source/code/example/android" ]
    },
    "webasm": {
        "emscripten": {
            "location": "build/webasm",
            "version": "6.0.2"
        }
    },
    "doxy": {
        "config": "source/configs/doxyfile"
    },
    "vulkan": {
        "version": "1.4.313.0"
    }
}
